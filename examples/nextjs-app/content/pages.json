  },
  {
    "id": "about",
    "slug": "/about",
    "schemaVersion": 1,
    "title": "About",
    "blocks": [
      {
        "id": "intro",
        "type": "hero",
        "content": {
          "heading": "About us",
          "description": "We build things."
        }
      }
    ]
  },
  {
    "id": "about-fr",
    "slug": "/about",
    "locale": "fr",
    "schemaVersion": 1,
    "title": "À propos",
    "blocks": [
      {
        "id": "intro",
        "type": "hero",
        "content": {
          "heading": "À propos",
          "description": "Nous construisons des choses."
        }
      }
    ]
  },
  {
    "id": "promo",
    "slug": "/sections/promo",
    "schemaVersion": 1,
    "blocks": [
      {
        "id": "promo",
        "type": "callToAction",
        "content": {
          "label": "Spring sale: 20% off. Read about us",
          "href": "/about"
        }
      }
    ]
