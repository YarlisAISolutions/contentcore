{
  "name": "@contentcore/core",
  "version": "0.1.1",
  "description": "Framework-agnostic ContentCore contracts: page documents, validation, schema migrations, static and API content sources.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YarlisAISolutions/contentcore.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/YarlisAISolutions/contentcore/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/YarlisAISolutions/contentcore/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "cms",
    "content",
    "headless-cms",
    "blocks",
    "standard-schema",
    "contentcore"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  }
}
