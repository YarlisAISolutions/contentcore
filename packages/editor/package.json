{
  "name": "@contentcore/editor",
  "version": "0.2.0",
  "description": "ContentCore Studio: a React UI to manage and edit ContentCore pages: page list, block editing with schema-driven forms, rich text, live validation and preview, for static (JSON) and API content.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YarlisAISolutions/contentcore.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/YarlisAISolutions/contentcore/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/YarlisAISolutions/contentcore/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "cms",
    "editor",
    "content-editor",
    "react",
    "headless-cms",
    "contentcore",
    "studio"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@contentcore/react": "^0.2.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@contentcore/react": "^0.2.0"
  }
}
